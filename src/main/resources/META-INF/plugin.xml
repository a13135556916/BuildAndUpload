<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
  <idea-version since-build="253" />
  <change-notes><![CDATA[Initial version]]></change-notes>
  <version>1.1-SNAPSHOT</version>
  <id>com.dguo.BuildAndUpload</id>
  <name>BuildAndUpload</name>
  <vendor>guodd</vendor>
  <description><![CDATA[<p><strong>Build &amp; Upload</strong> 基于 Git 变更进行编译与上传：</p>
        <ul>
            <li><code>Alt</code> + <code>-</code> 或 Tools | Build &amp; Upload：读取 Git 修改/新增，Java 上传对应 .class，JS 直接上传。</li>
            <li>项目视图 / 编辑器右键 | 编译该 Java 文件并上传：只编译当前选中的一个或多个 Java 文件并上传对应 .class，不依赖 Git 变更。</li>
            <li>Tools | Build &amp; Upload By Manifest：调用部署清单脚本生成 <code>upload-manifest.tsv</code>，并复用 IDEA Deployment 上传。</li>
            <li><code>Ctrl</code> + <code>Shift</code> + <code>F11</code> 或 Tools | Compile Changed Java：仅编译 Git 修改/新增的 Java 文件。</li>
            <li>默认调用 IDE Deployment 上传，也可在 Settings | Build &amp; Upload 中配置自定义上传/删除脚本。</li>
            <li>变更缺失或生成缺失会提示原因，避免空跑。</li>
        </ul>]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.java</depends>
  <depends>com.intellij.modules.vcs</depends>
  <extensions defaultExtensionNs="com.intellij">
    <notificationGroup id="BuildAndUpload" displayType="BALLOON" isLogByDefault="true" />
    <applicationConfigurable
        id="com.dguo.buildandupload.settings"
        displayName="Build &amp; Upload"
        instance="com.dguo.buildandupload.settings.UploadSettingsConfigurable" />
  </extensions>
  <actions>
    <action
        id="com.dguo.buildandupload.actions.BuildAndUploadAction"
        class="com.dguo.buildandupload.actions.BuildAndUploadAction"
        text="Build &amp; Upload"
        description="上传 Git 变更中的 Java/JS 文件">
      <add-to-group group-id="ToolsMenu" anchor="last" />
      <keyboard-shortcut keymap="$default" first-keystroke="alt MINUS" />
    </action>
    <action
        id="com.dguo.buildandupload.actions.BuildAndUploadSelectedAction"
        class="com.dguo.buildandupload.actions.BuildAndUploadSelectedAction"
        text="编译该 Java 文件并上传"
        description="编译当前选中的 Java 文件并上传对应 .class，不依赖 Git 变更">
      <add-to-group group-id="ProjectViewPopupMenuSettingsGroup" anchor="last" />
      <add-to-group group-id="EditorPopupMenu" anchor="last" />
      <add-to-group group-id="EditorTabPopupMenu" anchor="last" />
    </action>
    <action
        id="com.dguo.buildandupload.actions.CompileChangedJavaAction"
        class="com.dguo.buildandupload.actions.CompileChangedJavaAction"
        text="Compile Changed Java"
        description="编译 Git 变更中的 Java 文件">
      <add-to-group group-id="ToolsMenu" anchor="last" />
      <keyboard-shortcut keymap="$default" first-keystroke="control shift F11" />
    </action>
    <action
        id="com.dguo.buildandupload.actions.BuildAndUploadManifestAction"
        class="com.dguo.buildandupload.actions.BuildAndUploadManifestAction"
        text="Build &amp; Upload By Manifest"
        description="调用部署清单脚本并按 upload-manifest.tsv 上传文件">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>
    <action
        id="com.dguo.buildandupload.actions.BuildAndUploadManifestFromLogAction"
        class="com.dguo.buildandupload.actions.BuildAndUploadManifestFromLogAction"
        text="Build &amp; Upload From Selected Commit"
        description="在 Git 日志中选中一个 commit，直接编译并部署该 commit 的文件，自动忽略 XML">
      <add-to-group group-id="Vcs.Log.ContextMenu" anchor="last" />
    </action>
    <action
        id="com.dguo.buildandupload.actions.BuildAndUploadManifestFromSelectedCommitToLatestAction"
        class="com.dguo.buildandupload.actions.BuildAndUploadManifestFromSelectedCommitToLatestAction"
        text="Build &amp; Upload From Selected Commit To Latest"
        description="在 Git 日志中选中一个 commit，收集该 commit 到最新提交区间内的文件并编译上传，自动忽略 XML">
      <add-to-group group-id="Vcs.Log.ContextMenu" anchor="last" />
    </action>
  </actions>
</idea-plugin>
